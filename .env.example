
MONGODB_URI=

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


AUTH_SECRET=


ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Optional: defaults to SMTP_USER when blank.
ENQUIRY_EMAIL_TO=

# Canonical production domain. Keep all metadata and sitemaps on this origin.
NEXT_PUBLIC_SITE_URL=https://www.empiricalindia.com
# Set false on staging/preview deployments before building.
SITE_INDEXABLE=true
# Optional Search Console HTML verification token (not the full meta tag).
GOOGLE_SITE_VERIFICATION=
